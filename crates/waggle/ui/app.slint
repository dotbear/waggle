// Waggle's window: dark and compact, to sit beside the EVE client.

import { Palette, ScrollView } from "std-widgets.slint";
import { ActionButton, Theme } from "theme.slint";
import { SetupView, CharacterItem } from "setup.slint";

export { CharacterItem }


export struct IntelRow {
    system: string,
    jumps: string,
    age: string,
    message: string,
    reporter: string,
    pilot: string,
    critical: bool,
    via-bridge: bool,
}

export struct PingRow {
    title: string,
    link: string,
    fc: string,
    formup: string,
    pap-type: string,
    comms: string,
    age: string,
    strategic: bool,
    muted: bool,
    target: string,
}

export struct PilotRow {
    name: string,
    online: bool,
    known: bool,
    location: string,
    ship: string,
    training: string,
    problem: string,
}

export struct OreRow {
    name: string,
    amount: string,
}

export struct MiningGraph {
    shown: bool,
    line: string,
    area: string,
    top: string,
    average: float,
    from: string,
    to: string,
}

export struct MiningInfo {
    active: bool,
    title: string,
    total: string,
    rate: string,
    rate-hour: string,
    hold-percent: float,
    hold-text: string,
    ores: [OreRow],
    graph: MiningGraph,
}

/// Yield over the last few minutes, with the session average dashed across.
component YieldGraph inherits VerticalLayout {
    in property <MiningGraph> graph;
    spacing: 2px;
    HorizontalLayout {
        Text {
            text: graph.top;
            color: Theme.faint;
            font-size: Theme.small;
        }
        Rectangle { }
        if graph.average >= 0: Text {
            text: "- - average";
            color: Theme.faint;
            font-size: Theme.small;
        }
    }
    Rectangle {
        height: 90px;
        border-width: 1px;
        border-color: Theme.line;
        border-radius: 4px;
        clip: true;
        Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 1000;
            viewbox-height: 100;
            // Stretch to the box; the default keeps the 10:1 aspect.
            fit: fill;
            commands: graph.area;
            fill: Theme.gold.with-alpha(0.15);
            stroke: transparent;
        }
        Path {
            width: parent.width;
            height: parent.height;
            viewbox-width: 1000;
            viewbox-height: 100;
            // Stretch to the box; the default keeps the 10:1 aspect.
            fit: fill;
            commands: graph.line;
            fill: transparent;
            stroke: Theme.gold;
            stroke-width: 1.5px;
        }
        if graph.average >= 0: HorizontalLayout {
            y: parent.height * (1 - graph.average) - 0.5px;
            height: 1px;
            spacing: 4px;
            for _ in 40: Rectangle {
                background: Theme.dim;
            }
        }
    }
    HorizontalLayout {
        Text {
            text: graph.from;
            color: Theme.faint;
            font-size: Theme.small;
        }
        Rectangle { }
        Text {
            text: graph.to;
            color: Theme.faint;
            font-size: Theme.small;
        }
    }
}

component Badge inherits Rectangle {
    in property <string> text;
    in property <color> tint: Theme.dim;
    height: 16px;
    width: label.preferred-width + 10px;
    border-radius: 3px;
    background: tint.transparentize(80%);
    label := Text {
        text: root.text;
        color: root.tint;
        font-size: Theme.small;
        font-weight: 600;
        vertical-alignment: center;
        horizontal-alignment: center;
    }
}

component Tab inherits Rectangle {
    in property <string> label;
    in property <bool> active;
    callback clicked;
    height: 28px;
    background: touch.has-hover && !active ? Theme.raised : transparent;
    Text {
        text: root.label;
        color: root.active ? Theme.gold : Theme.dim;
        font-size: Theme.small;
        font-weight: 700;
        letter-spacing: 1px;
        horizontal-alignment: center;
        vertical-alignment: center;
    }
    Rectangle {
        y: parent.height - 2px;
        height: 2px;
        background: root.active ? Theme.gold : transparent;
    }
    touch := TouchArea {
        clicked => { root.clicked(); }
    }
}

component Empty inherits VerticalLayout {
    in property <string> title;
    in property <string> hint;
    alignment: center;
    padding: 24px;
    spacing: 6px;
    Text {
        text: root.title;
        color: Theme.text;
        font-size: Theme.heading;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
    Text {
        text: root.hint;
        color: Theme.dim;
        font-size: Theme.body;
        horizontal-alignment: center;
        wrap: word-wrap;
    }
}

component IntelItem inherits Rectangle {
    in property <IntelRow> item;
    background: item.critical ? Theme.red.transparentize(88%) : transparent;
    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 2px;
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: item.system;
                color: item.critical ? Theme.red : Theme.text;
                font-size: Theme.heading;
                font-weight: 700;
                vertical-alignment: center;
            }
            Badge {
                text: item.jumps;
                tint: item.critical ? Theme.red : Theme.gold;
            }
            if item.via-bridge: Badge {
                text: "via bridge";
                tint: Theme.blue;
            }
            Rectangle { }
            Text {
                text: item.age;
                color: Theme.faint;
                font-size: Theme.small;
                vertical-alignment: center;
            }
        }
        Text {
            text: item.message;
            color: Theme.dim;
            font-size: Theme.body;
            overflow: elide;
        }
        Text {
            text: item.reporter + "  ·  near " + item.pilot;
            color: Theme.faint;
            font-size: Theme.small;
            overflow: elide;
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line;
    }
}

component PingItem inherits Rectangle {
    in property <PingRow> item;
    callback open-link(string);
    callback toggle-mute(string);
    opacity: item.muted ? 0.55 : 1.0;
    background: item.link != "" && ping-touch.has-hover ? Theme.raised : transparent;
    ping-touch := TouchArea {
        enabled: item.link != "";
        mouse-cursor: item.link != "" ? pointer : default;
        clicked => { root.open-link(item.link); }
    }
    VerticalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 6px;
        padding-bottom: 6px;
        spacing: 2px;
        HorizontalLayout {
            spacing: 6px;
            Text {
                text: item.title;
                color: Theme.text;
                font-size: Theme.heading;
                font-weight: 700;
                overflow: elide;
                vertical-alignment: center;
            }
            if item.pap-type != "": Badge {
                text: item.pap-type;
                tint: item.strategic ? Theme.gold : Theme.dim;
            }
            Rectangle { }
            Text {
                text: item.age;
                color: Theme.faint;
                font-size: Theme.small;
                vertical-alignment: center;
            }
        }
        if item.fc != "" || item.formup != "": Text {
            text: (item.fc != "" ? "FC " + item.fc : "") + (item.fc != "" && item.formup != "" ? "  ·  " : "") + (item.formup != "" ? item.formup : "");
            color: Theme.dim;
            font-size: Theme.body;
            overflow: elide;
        }
        if item.comms != "": Text {
            text: item.link != "" ? item.comms + "  ·  click to join" : item.comms;
            color: item.link != "" ? Theme.blue : Theme.faint;
            font-size: Theme.small;
            overflow: elide;
        }
        // Who Directorbot sent it to, and a way to stop hearing from them.
        if item.target != "": HorizontalLayout {
            spacing: 6px;
            Text {
                text: "to " + item.target + (item.muted ? "  ·  muted" : "");
                color: Theme.faint;
                font-size: Theme.small;
                overflow: elide;
            }
            Rectangle { }
            mute-touch := TouchArea {
                width: mute-text.preferred-width;
                mouse-cursor: pointer;
                clicked => { root.toggle-mute(item.target); }
                mute-text := Text {
                    text: item.muted ? "Unmute" : "Mute";
                    color: mute-touch.has-hover ? Theme.text : Theme.dim;
                    font-size: Theme.small;
                }
            }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line;
    }
}

component PilotItem inherits Rectangle {
    in property <PilotRow> item;
    HorizontalLayout {
        padding-left: 10px;
        padding-right: 10px;
        padding-top: 7px;
        padding-bottom: 7px;
        spacing: 8px;
        Rectangle {
            width: 8px;
            height: 8px;
            y: 5px;
            border-radius: 4px;
            background: !item.known ? Theme.faint : item.online ? Theme.green : Theme.line;
        }
        VerticalLayout {
            spacing: 2px;
            Text {
                text: item.name;
                color: Theme.text;
                font-size: Theme.heading;
                font-weight: 600;
                overflow: elide;
            }
            if item.location != "" || item.ship != "": Text {
                text: item.location + (item.location != "" && item.ship != "" ? "  ·  " : "") + item.ship;
                color: Theme.dim;
                font-size: Theme.body;
                overflow: elide;
            }
            if item.training != "": Text {
                text: item.training;
                color: Theme.faint;
                font-size: Theme.small;
                overflow: elide;
            }
            if item.problem != "": Text {
                text: item.problem;
                color: Theme.gold;
                font-size: Theme.small;
                wrap: word-wrap;
            }
        }
    }
    Rectangle {
        y: parent.height - 1px;
        height: 1px;
        background: Theme.line;
    }
}

component MiningPane inherits VerticalLayout {
    in property <MiningInfo> info;
    callback start-session();
    callback stop-session();
    alignment: start;
    padding: 12px;
    spacing: 10px;
    HorizontalLayout {
        Text {
            text: info.active ? info.title : info.title + "  ·  ENDED";
            color: Theme.dim;
            font-size: Theme.small;
            font-weight: 700;
            letter-spacing: 1px;
            vertical-alignment: center;
        }
        Rectangle { }
        ActionButton {
            text: info.active ? "Stop" : "Start";
            primary: !info.active;
            clicked => {
                if (info.active) {
                    root.stop-session();
                } else {
                    root.start-session();
                }
            }
        }
    }
    HorizontalLayout {
        spacing: 16px;
        VerticalLayout {
            Text {
                text: info.total;
                color: Theme.text;
                font-size: 22px;
                font-weight: 700;
            }
            Text {
                text: "mined";
                color: Theme.faint;
                font-size: Theme.small;
            }
        }
        VerticalLayout {
            Text {
                text: info.rate;
                color: Theme.gold;
                font-size: 22px;
                font-weight: 700;
            }
            Text {
                text: info.rate-hour == "" ? "average" : "average · " + info.rate-hour;
                color: Theme.faint;
                font-size: Theme.small;
            }
        }
    }
    // Only once ESI has said which ship, and so how big its hold is.
    if info.hold-text != "": VerticalLayout {
        spacing: 4px;
        Rectangle {
            height: 8px;
            border-radius: 4px;
            background: Theme.raised;
            Rectangle {
                x: 0;
                width: parent.width * clamp(info.hold-percent, 0, 1);
                border-radius: 4px;
                background: info.hold-percent >= 0.95 ? Theme.red : Theme.gold;
            }
        }
        Text {
            text: info.hold-text;
            color: Theme.dim;
            font-size: Theme.small;
        }
    }
    if info.graph.shown: YieldGraph {
        graph: info.graph;
    }
    for ore in info.ores: HorizontalLayout {
        Text {
            text: ore.name;
            color: Theme.dim;
            font-size: Theme.body;
            overflow: elide;
        }
        Rectangle { }
        Text {
            text: ore.amount;
            color: Theme.text;
            font-size: Theme.body;
        }
    }
}

export component AppWindow inherits Window {
    title: "Waggle";
    icon: @image-url("waggle.png");
    preferred-width: 380px;
    preferred-height: 600px;
    min-width: 300px;
    min-height: 360px;

    in property <string> paps-month: "–";
    in property <string> paps-30: "–";
    in property <string> paps-90: "–";
    in property <string> jabber-text: "Jabber not set up";
    in property <bool> jabber-ok: false;
    in property <string> setup-hint;
    in property <string> update-text;
    in property <string> update-url;
    in property <string> status;
    in property <[IntelRow]> intel;
    in property <[PingRow]> pings;
    in property <[PilotRow]> pilots;
    in property <MiningInfo> mining;
    in-out property <int> tab: 0;
    in-out property <bool> setup-open;
    in property <bool> first-run <=> setup.first-run;
    in property <[CharacterItem]> setup-characters <=> setup.characters;
    in property <string> character-status <=> setup.character-status;
    in property <bool> adding-character <=> setup.adding-character;
    in property <bool> rift-available <=> setup.rift-available;
    in property <string> rift-status <=> setup.rift-status;
    in-out property <string> jabber-user <=> setup.jabber-user;
    in-out property <string> jabber-password <=> setup.jabber-password;
    in property <bool> jabber-password-saved <=> setup.jabber-password-saved;
    in property <string> jabber-domain <=> setup.jabber-domain;
    in property <[CharacterItem]> setup-channels <=> setup.channels;
    in property <[CharacterItem]> setup-muted <=> setup.muted;
    in-out property <string> new-channel <=> setup.new-channel;
    in-out property <int> max-jumps <=> setup.max-jumps;
    in-out property <bool> only-undocked <=> setup.only-undocked;
    in-out property <bool> notifications <=> setup.notifications;
    in-out property <int> privacy <=> setup.privacy;
    in-out property <bool> start-with-windows <=> setup.start-with-windows;
    in property <bool> can-start-with-windows <=> setup.can-start-with-windows;
    in property <string> data-folder <=> setup.data-folder;
    callback open-setup();
    callback add-character <=> setup.add-character;
    callback remove-character <=> setup.remove-character;
    callback import-rift <=> setup.import-rift;
    callback add-channel <=> setup.add-channel;
    callback remove-channel <=> setup.remove-channel;
    callback unmute <=> setup.unmute;
    callback toggle-mute(string);
    callback save-setup <=> setup.save;
    callback cancel-setup <=> setup.cancel;
    callback test-alert <=> setup.test-alert;
    /// Flipped every time the window is shown again, so the whole window is
    /// dirty and the software renderer repaints all of it.
    in property <bool> nudge;

    callback refresh-paps();
    callback mining-start();
    callback mining-stop();
    callback open-link(string);

    background: nudge ? Theme.background : Theme.background.darker(0.0001);
    default-font-size: Theme.body;
    init => {
        Palette.color-scheme = ColorScheme.dark;
    }

    VerticalLayout {
        // Header: PAP counts and the Directorbot connection.
        Rectangle {
            background: Theme.panel;
            HorizontalLayout {
                padding: 10px;
                spacing: 12px;
                VerticalLayout {
                    alignment: center;
                    Text {
                        text: "WAGGLE";
                        color: Theme.gold;
                        font-size: Theme.small;
                        font-weight: 800;
                        letter-spacing: 2px;
                    }
                    HorizontalLayout {
                        spacing: 4px;
                        Rectangle {
                            width: 6px;
                            height: 6px;
                            y: 4px;
                            border-radius: 3px;
                            background: root.jabber-ok ? Theme.green : Theme.faint;
                        }
                        Text {
                            text: root.jabber-text;
                            color: Theme.dim;
                            font-size: Theme.small;
                            overflow: elide;
                        }
                    }
                }
                Rectangle { }
                for period[index] in [
                    { label: "MONTH", value: root.paps-month },
                    { label: "30 D", value: root.paps-30 },
                    { label: "90 D", value: root.paps-90 },
                ]: VerticalLayout {
                    alignment: center;
                    Text {
                        text: period.value;
                        color: index == 0 ? Theme.text : Theme.dim;
                        font-size: index == 0 ? 15px : Theme.body;
                        font-weight: 700;
                        horizontal-alignment: right;
                    }
                    Text {
                        text: period.label;
                        color: Theme.faint;
                        font-size: 9px;
                        letter-spacing: 1px;
                        horizontal-alignment: right;
                    }
                }
                refresh := TouchArea {
                    width: 18px;
                    clicked => { root.refresh-paps(); }
                    Text {
                        text: "↻";
                        color: refresh.has-hover ? Theme.gold : Theme.faint;
                        font-size: 14px;
                    }
                }
                gear := TouchArea {
                    width: 18px;
                    clicked => { root.open-setup(); }
                    Text {
                        text: "⚙";
                        color: root.setup-open || gear.has-hover ? Theme.gold : Theme.faint;
                        font-size: 14px;
                    }
                }
            }
        }

        Rectangle {
            vertical-stretch: 1;
            VerticalLayout {
                visible: !root.setup-open;
                if root.update-text != "": Rectangle {
                    background: update-touch.has-hover ? Theme.blue.transparentize(70%) : Theme.blue.transparentize(82%);
                    HorizontalLayout {
                        padding: 8px;
                        Text {
                            text: root.update-text;
                            color: Theme.blue;
                            font-size: Theme.body;
                            wrap: word-wrap;
                        }
                    }
                    update-touch := TouchArea {
                        mouse-cursor: pointer;
                        clicked => { root.open-link(root.update-url); }
                    }
                }
                if root.setup-hint != "": Rectangle {
                    background: Theme.gold.transparentize(85%);
                    HorizontalLayout {
                        padding: 8px;
                        Text {
                            text: root.setup-hint;
                            color: Theme.gold;
                            font-size: Theme.body;
                            wrap: word-wrap;
                        }
                    }
                }

                // Tabs.
                Rectangle {
                    background: Theme.panel;
                    HorizontalLayout {
                        Tab {
                            label: "INTEL";
                            active: root.tab == 0;
                            clicked => { root.tab = 0; }
                        }
                        Tab {
                            label: "PINGS";
                            active: root.tab == 1;
                            clicked => { root.tab = 1; }
                        }
                        Tab {
                            label: "MINING";
                            active: root.tab == 2;
                            clicked => { root.tab = 2; }
                        }
                        Tab {
                            label: "PILOTS";
                            active: root.tab == 3;
                            clicked => { root.tab = 3; }
                        }
                    }
                    Rectangle {
                        y: parent.height - 1px;
                        height: 1px;
                        background: Theme.line;
                    }
                }

                // Content.
                Rectangle {
                    vertical-stretch: 1;
                    if root.tab == 0 && root.intel.length == 0: Empty {
                        title: "No hostiles near your pilots";
                        hint: "Reports from your intel channels show up here when they are within range of a linked pilot.";
                    }
                    if root.tab == 0 && root.intel.length > 0: ScrollView {
                        VerticalLayout {
                            alignment: start;
                            for row in root.intel: IntelItem { item: row; }
                        }
                    }
                    if root.tab == 1 && root.pings.length == 0: Empty {
                        title: "No fleet pings yet";
                        hint: "Directorbot broadcasts arrive here once Jabber is connected.";
                    }
                    if root.tab == 1 && root.pings.length > 0: ScrollView {
                        VerticalLayout {
                            alignment: start;
                            for row in root.pings: PingItem {
                        item: row;
                        open-link(url) => { root.open-link(url); }
                        toggle-mute(target) => { root.toggle-mute(target); }
                    }
                        }
                    }
                    if root.tab == 2 && !root.mining.active && root.mining.ores.length == 0: VerticalLayout {
                        alignment: center;
                        Empty {
                            title: "Not mining";
                            hint: "A session starts by itself when your game log shows ore coming in, and ends after five minutes without any.";
                        }
                        HorizontalLayout {
                            alignment: center;
                            ActionButton {
                                text: "Start a session now";
                                clicked => { root.mining-start(); }
                            }
                        }
                    }
                    if root.tab == 2 && (root.mining.active || root.mining.ores.length > 0): MiningPane {
                        info: root.mining;
                        start-session => { root.mining-start(); }
                        stop-session => { root.mining-stop(); }
                    }
                    if root.tab == 3 && root.pilots.length == 0: Empty {
                        title: "No pilots linked";
                        hint: "Add a character to see where it is and to measure intel distance from it.";
                    }
                    if root.tab == 3 && root.pilots.length > 0: ScrollView {
                        VerticalLayout {
                            alignment: start;
                            for row in root.pilots: PilotItem { item: row; }
                        }
                    }
                }

                // Status line.
                Rectangle {
                    background: Theme.panel;
                    HorizontalLayout {
                        padding-left: 10px;
                        padding-right: 10px;
                        padding-top: 4px;
                        padding-bottom: 4px;
                        Text {
                            text: root.status;
                            color: Theme.faint;
                            font-size: Theme.small;
                            overflow: elide;
                        }
                    }
                }
            }
            setup := SetupView {
                visible: root.setup-open;
            }
        }
    }
}
